<resources>
    <style name="Theme.Beam" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#110F08</item>
        <item name="android:navigationBarColor">#110F08</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Beam.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#110F08</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Beam</item>
    </style>
</resources>
