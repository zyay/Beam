# Copy to .env.local for development. On Vercel: Settings -> Environment Variables.
# Never commit the filled-in copy — .gitignore only whitelists this template.

# --- Required ---

# Vercel AI Gateway key (https://vercel.com/ai). Chat answers come from here.
# Without it: POST /api/chat returns 503 with a "chat is not connected" notice.
AI_GATEWAY_KEY=

# Postgres connection string (Vercel Postgres or Neon). Stores accounts + profiles.
# Without it: local dev silently falls back to a .data/users.json file store,
# but on Vercel the auth routes throw NO_DB rather than writing to an ephemeral
# filesystem. So a deployed fork needs a real database.
POSTGRES_URL=

# JWT signing secret for sessions. Generate one: openssl rand -base64 32
# WARNING: lib/auth.ts has a hardcoded development fallback. If you leave this
# unset in production, your sessions are signed with a secret that is public in
# this repository. Always set it.
AUTH_SECRET=

# --- Optional ---

# Any model your AI Gateway key can reach. Defaults to minimax/minimax-m3.
AI_GATEWAY_MODEL=minimax/minimax-m3

# --- Android CI (NOT read from this file) ---
#
# These belong in GitHub repo Settings -> Secrets and variables -> Actions ->
# Variables, and are consumed by .github/workflows/android-release.yml:
#
#   BEAM_SERVER_URL   backend the APK talks to (defaults to the demo deployment)
#   BEAM_GOOGLE_KEY   Gemini Live API key, enables native voice mode.
#                     Left blank, the voice screen shows a notice instead of crashing.
#
# Note: an unset GitHub variable resolves to an empty string, not null, so
# build.gradle.kts guards with .getOrElse(default).trim().ifEmpty { default }.
